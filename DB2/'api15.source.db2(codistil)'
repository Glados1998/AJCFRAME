       IDENTIFICATION DIVISION.
       PROGRAM-ID. CODISTIL.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT F-IN
               ASSIGN TO ETATDATA
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE  IS SEQUENTIAL
               FILE STATUS  IS WS-FS-IN.
           SELECT F-OUT
               ASSIGN TO FACTURES
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE  IS SEQUENTIAL
               FILE STATUS  IS WS-FS-OUT.
       DATA DIVISION.
       FILE SECTION.
       FD  F-IN
           RECORDING MODE IS F
           RECORD CONTAINS 200 CHARACTERS.
       01  ENR-IN                     PIC X(200).
       FD  F-OUT
           RECORDING MODE IS F
           RECORD CONTAINS 200 CHARACTERS.
       01  ENR-OUT                    PIC X(200).
       WORKING-STORAGE SECTION.
       77  WS-FS-IN                  PIC XX  VALUE SPACES.
       77  WS-FS-OUT                 PIC XX  VALUE SPACES.
       77  WS-EOF                    PIC X   VALUE 'N'.
       01  WS-CSV-FIELDS.
           05 F-ORDER-NO             PIC X(3).
           05 F-ORDER-DATE           PIC X(10).
           05 F-COMPANY              PIC X(30).
           05 F-ADDRESS              PIC X(40).
           05 F-CITY                 PIC X(20).
           05 F-STATE                PIC X(2).
           05 F-ZIP                  PIC X(5).
           05 F-PHONE                PIC X(10).
           05 F-DNAME                PIC X(20).
           05 F-LNAME                PIC X(20).
           05 F-FNAME                PIC X(20).
           05 F-COM-RATE             PIC X(4).
           05 F-DESCRIPTION          PIC X(30).
           05 F-PNO                  PIC X(4).
           05 F-QTY                  PIC X(4).
           05 F-PRICE-SOLD           PIC X(9).
           05 F-PRICE-CATALOG        PIC X(9).
       01  WS-CURRENT-ORDER          PIC X(3) VALUE SPACES.
       01  WS-FIRST-ORDER            PIC X    VALUE 'Y'.
       01  WS-DATE-LETTRES       PIC X(40).
       01  WS-QTY-NUM              PIC S9(4)     VALUE 0.
       01  WS-PRICE-NUM            PIC S9(5)V99  VALUE 0.
       01  WS-PRICE-TXT            PIC Z(5).99.
       01  WS-LINE-TOTAL-N         PIC S9(7)V99  VALUE 0.
       01  WS-LINE-TOTAL-TXT       PIC Z(7).99.
       01  WS-CAT-NUM            PIC S9(5)V99 VALUE 0.
       01  WS-SOLD-NUM           PIC S9(5)V99 VALUE 0.
       01  WS-REMISE-N           PIC S9(5)V99 VALUE 0.
       01  WS-REMISE-TXT         PIC Z(5).99.
       01  WS-TAX-RATE          PIC 99 VALUE 0.
       01  WS-LINE                   PIC X(200).
       01  WS-COM-RATE-NUM         PIC S9V99     VALUE 0.
       01  WS-LINE-COMM-N            PIC S9(7)V99  VALUE 0.
       01  WS-LINE-COMM-TXT          PIC Z(7).99.
       01  WS-TOTAL-COMM-N           PIC S9(7)V99  VALUE 0.
       01  WS-TOTAL-COMM-TXT         PIC Z(7).99.
       01  WS-SUBTOTAL-N             PIC S9(9)V99   VALUE 0.
       01  WS-SUBTOTAL-TXT           PIC Z(9).99.
       01  WS-TOTAL-DISCOUNT-N       PIC S9(9)V99   VALUE 0.
       01  WS-TOTAL-DISCOUNT-TXT     PIC Z(9).99.
       01  WS-TAX-NUM            PIC S9(9)V99 VALUE 0.
       01  WS-TAX-TXT            PIC Z(9).99.
       01  WS-TOTAL-N            PIC S9(9)V99 VALUE 0.
       01  WS-TOTAL-TXT          PIC Z(9).99.
       01 WS-COM-PERCENT PIC 99       VALUE 0.
       01 WS-COM-PERCENT-TXT PIC X(6).
       01 WS-COM-PERCENT-EDIT PIC ZZ9.9.
       01 WS-TAX-PERCENT        PIC 99       VALUE 0.
       01 WS-TAX-PERCENT-TXT    PIC X(6).
       01 WS-TAX-PERCENT-EDIT    PIC ZZ9.9.
       01  F-DNAME-TRIM   PIC X(20).
       01  F-LNAME-TRIM   PIC X(20).
       01  F-FNAME-TRIM   PIC X(20).
       01 WS-DNAME-LEN  PIC 99.
       01 WS-LNAME-LEN  PIC 99.
       01 WS-FNAME-LEN  PIC 99.
       01 WS-TRIM-INDEX PIC 99.
       PROCEDURE DIVISION.
       MAIN-SECTION.
           PERFORM INIT-PROGRAM
           PERFORM TRAITER-FICHIER
           PERFORM FIN-PROGRAM
           GOBACK
           .

       INIT-PROGRAM.
           OPEN INPUT  F-IN
                OUTPUT F-OUT
           IF WS-FS-IN NOT = "00"
              DISPLAY "ERREUR OUVERTURE F-IN  FS=" WS-FS-IN
              STOP RUN
           END-IF
           IF WS-FS-OUT NOT = "00"
              DISPLAY "ERREUR OUVERTURE F-OUT FS=" WS-FS-OUT
              STOP RUN
           END-IF
           ACCEPT WS-TAX-RATE FROM SYSIN
           CALL 'COBG53DT' USING WS-DATE-LETTRES
           .

       TRAITER-FICHIER.
           PERFORM LIRE-ENREGISTREMENT
           PERFORM UNTIL WS-EOF = 'Y'
              PERFORM PARSER-CSV
              PERFORM GERER-CHANGEMENT-COMMANDE
              PERFORM ECRIRE-LIGNE-ITEM
              PERFORM LIRE-ENREGISTREMENT
           END-PERFORM

           IF WS-FIRST-ORDER = 'N'
              PERFORM ECRIRE-PIED-FACTURE
           END-IF
           .

       LIRE-ENREGISTREMENT.
           READ F-IN
              AT END
                 MOVE 'Y' TO WS-EOF
           END-READ
           IF WS-EOF NOT = 'Y'
              IF WS-FS-IN NOT = "00"
                 DISPLAY "ERREUR LECTURE F-IN  FS=" WS-FS-IN
                 STOP RUN
              END-IF
           END-IF
           .

       PARSER-CSV.
           MOVE SPACES TO WS-CSV-FIELDS

           UNSTRING ENR-IN
              DELIMITED BY ';'
              INTO
                 F-ORDER-NO
                 F-ORDER-DATE
                 F-COMPANY
                 F-ADDRESS
                 F-CITY
                 F-STATE
                 F-ZIP
                 F-PHONE
                 F-DNAME
                 F-LNAME
                 F-FNAME
                 F-COM-RATE
                 F-DESCRIPTION
                 F-PNO
                 F-QTY
                 F-PRICE-SOLD
                 F-PRICE-CATALOG
           END-UNSTRING
           .

       GERER-CHANGEMENT-COMMANDE.
           IF WS-FIRST-ORDER = 'Y'
              MOVE 0 TO WS-TOTAL-COMM-N
              MOVE 0 TO WS-SUBTOTAL-N
              MOVE 0 TO WS-TOTAL-DISCOUNT-N
              MOVE F-ORDER-NO TO WS-CURRENT-ORDER
              MOVE 'N'        TO WS-FIRST-ORDER
              PERFORM ECRIRE-ENTETE-FACTURE
           ELSE
              IF F-ORDER-NO NOT = WS-CURRENT-ORDER
                 PERFORM ECRIRE-PIED-FACTURE
                 MOVE ALL ' ' TO WS-LINE
                 WRITE ENR-OUT FROM WS-LINE AFTER ADVANCING PAGE
                 MOVE 0 TO WS-TOTAL-COMM-N
                 MOVE 0 TO WS-SUBTOTAL-N
                 MOVE 0 TO WS-TOTAL-DISCOUNT-N
                 MOVE F-ORDER-NO TO WS-CURRENT-ORDER
                 PERFORM ECRIRE-ENTETE-FACTURE
              END-IF
           END-IF
           .
       ECRIRE-ENTETE-FACTURE.

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                       '
              ' _______________________________'
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                      '
              '  ' F-COMPANY    '  '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                     '
              '   ' F-ADDRESS   '  '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                     '
              '   ' F-CITY ', ' F-ZIP    '  '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                    '
              '    ' F-STATE    '  '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                     '
              '   ' F-PHONE '  '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '                                       '
              ' _______________________________'
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
             'New York, ' WS-DATE-LETTRES
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING 'O_NO   ' F-ORDER-NO
              DELIMITED BY SIZE
           INTO WS-LINE END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING 'O_DATE ' F-ORDER-DATE
              DELIMITED BY SIZE
           INTO WS-LINE END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE

           MOVE 20 TO WS-DNAME-LEN
           MOVE 20 TO WS-TRIM-INDEX
           PERFORM VARYING WS-TRIM-INDEX FROM 20 BY -1
                   UNTIL WS-TRIM-INDEX = 0
                      OR F-DNAME(WS-TRIM-INDEX:1) NOT = ' '
           END-PERFORM
           IF WS-TRIM-INDEX = 0
              MOVE 0 TO WS-DNAME-LEN
           ELSE
              MOVE WS-TRIM-INDEX TO WS-DNAME-LEN
           END-IF
           MOVE 20 TO WS-LNAME-LEN
           MOVE 20 TO WS-TRIM-INDEX
           PERFORM VARYING WS-TRIM-INDEX FROM 20 BY -1
                   UNTIL WS-TRIM-INDEX = 0
                      OR F-LNAME(WS-TRIM-INDEX:1) NOT = ' '
           END-PERFORM
           IF WS-TRIM-INDEX = 0
              MOVE 0 TO WS-LNAME-LEN
           ELSE
              MOVE WS-TRIM-INDEX TO WS-LNAME-LEN
           END-IF
           MOVE 20 TO WS-FNAME-LEN
           MOVE 20 TO WS-TRIM-INDEX
           PERFORM VARYING WS-TRIM-INDEX FROM 20 BY -1
                   UNTIL WS-TRIM-INDEX = 0
                      OR F-FNAME(WS-TRIM-INDEX:1) NOT = ' '
           END-PERFORM
           IF WS-TRIM-INDEX = 0
              MOVE 0 TO WS-FNAME-LEN
           ELSE
              MOVE WS-TRIM-INDEX TO WS-FNAME-LEN
           END-IF
           MOVE ALL ' ' TO WS-LINE
           STRING
              'Your contact within the department '
              F-DNAME(1:WS-DNAME-LEN)
              ' : '
              F-LNAME(1:WS-LNAME-LEN)
              ', '
              F-FNAME(1:WS-FNAME-LEN)
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE
           MOVE ALL ' ' TO WS-LINE
           STRING
              '============================================='
              '========================='
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           MOVE ALL ' ' TO WS-LINE
           STRING
              'P_NO  '
              '|DESCRIPTION                     '
              '|QUANT.'
              '|PRICE     '
              '|LINE TOTAL  '
              DELIMITED BY SIZE
           INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           MOVE ALL ' ' TO WS-LINE
           STRING
              '---------------------------------------------'
              '-------------------------'
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           .

       ECRIRE-LIGNE-ITEM.
           PERFORM CONVERT-QTY
           PERFORM CONVERT-PRICE
           PERFORM CONVERT-COM
           COMPUTE WS-LINE-TOTAL-N = WS-QTY-NUM * WS-PRICE-NUM
           ADD WS-LINE-TOTAL-N TO WS-SUBTOTAL-N
           COMPUTE WS-REMISE-N =
           (WS-CAT-NUM - WS-PRICE-NUM) * WS-QTY-NUM
           ADD WS-REMISE-N TO WS-TOTAL-DISCOUNT-N
           COMPUTE WS-LINE-COMM-N = WS-LINE-TOTAL-N * WS-COM-RATE-NUM
           ADD WS-LINE-COMM-N TO WS-TOTAL-COMM-N
           MOVE WS-LINE-TOTAL-N TO WS-LINE-TOTAL-TXT
           MOVE WS-PRICE-NUM    TO WS-PRICE-TXT
           DISPLAY 'DEBUG PRICE: F-PRICE-SOLD = [' F-PRICE-SOLD ']'
                   ' WS-PRICE-NUM = ' WS-PRICE-TXT.
           MOVE ALL ' ' TO WS-LINE

           STRING
              ' ' F-PNO              ' | '
              F-DESCRIPTION          ' | '
              F-QTY                  ' | '
              WS-PRICE-TXT           ' | '
              WS-LINE-TOTAL-TXT      ' '
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING

           PERFORM ECRIRE-OUT-LIGNE
           .


       ECRIRE-PIED-FACTURE.
           MOVE ALL ' ' TO WS-LINE
           STRING
              '============================================='
              '========================='
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE

           MOVE WS-TOTAL-DISCOUNT-N TO WS-TOTAL-DISCOUNT-TXT
           MOVE ALL ' ' TO WS-LINE
           STRING
           'DISCOUNT           '
           WS-TOTAL-DISCOUNT-TXT
           DELIMITED BY SIZE
           INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           MOVE WS-SUBTOTAL-N TO WS-SUBTOTAL-TXT
           MOVE ALL ' ' TO WS-LINE
           STRING
           'SUB TOTAL          '
           WS-SUBTOTAL-TXT
           DELIMITED BY SIZE
           INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           COMPUTE WS-TAX-NUM = WS-SUBTOTAL-N * (WS-TAX-RATE / 100)
           MOVE WS-TAX-NUM TO WS-TAX-TXT
           MOVE WS-TAX-RATE TO WS-TAX-PERCENT
           MOVE WS-TAX-PERCENT TO WS-TAX-PERCENT-EDIT
           INSPECT WS-TAX-PERCENT-EDIT CONVERTING '.' TO ','
           MOVE ALL ' ' TO WS-LINE
           STRING
           'SALES TAX  ('
           WS-TAX-PERCENT-EDIT
           '%)'
           WS-TAX-TXT
           DELIMITED BY SIZE
           INTO WS-LINE END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           COMPUTE WS-COM-PERCENT = WS-COM-RATE-NUM * 100
           MOVE WS-TOTAL-COMM-N TO WS-TOTAL-COMM-TXT
           MOVE WS-COM-PERCENT TO WS-COM-PERCENT-EDIT
           INSPECT WS-COM-PERCENT-EDIT CONVERTING '.' TO ','
           MOVE ALL ' ' TO WS-LINE
           STRING
           'COMMISSION ('
           WS-COM-PERCENT-EDIT
           '%)  '
           WS-TOTAL-COMM-TXT
           DELIMITED BY SIZE
           INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           COMPUTE WS-TOTAL-N =
                   WS-SUBTOTAL-N
                 + WS-TAX-NUM
           MOVE WS-TOTAL-N TO WS-TOTAL-TXT

           MOVE ALL ' ' TO WS-LINE
           STRING 'TOTAL              ' WS-TOTAL-TXT
           DELIMITED BY SIZE
           INTO WS-LINE END-STRING
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           PERFORM ECRIRE-OUT-LIGNE

           MOVE ALL ' ' TO WS-LINE
           STRING
              '____________________________________________'
              '___________________________'
              DELIMITED BY SIZE
              INTO WS-LINE
           END-STRING
           PERFORM ECRIRE-OUT-LIGNE
           .

       ECRIRE-OUT-LIGNE.
           WRITE ENR-OUT FROM WS-LINE
           IF WS-FS-OUT NOT = "00"
              DISPLAY "ERREUR ECRITURE F-OUT FS=" WS-FS-OUT
              STOP RUN
           END-IF
           .
       CONVERT-QTY.
           MOVE 0 TO WS-QTY-NUM
           IF F-QTY NOT = SPACES
           COMPUTE WS-QTY-NUM = FUNCTION NUMVAL(F-QTY)
           END-IF
           .
       CONVERT-COM.
           MOVE 0 TO WS-COM-RATE-NUM
           IF F-COM-RATE NOT = SPACES
           COMPUTE WS-COM-RATE-NUM = FUNCTION NUMVAL (F-COM-RATE)
           END-IF
           .
       CONVERT-PRICE.
           MOVE 0 TO WS-PRICE-NUM
           MOVE 0 TO WS-CAT-NUM
           IF F-PRICE-SOLD NOT = SPACES
           COMPUTE WS-PRICE-NUM = FUNCTION NUMVAL(F-PRICE-SOLD)
           END-IF
           IF F-PRICE-CATALOG NOT = SPACES
                COMPUTE WS-CAT-NUM = FUNCTION NUMVAL(F-PRICE-CATALOG)
           END-IF
           .
       FIN-PROGRAM.
           CLOSE F-IN
           IF WS-FS-IN NOT = "00"
           DISPLAY "ERREUR CLOSE F-IN   FS=" WS-FS-IN
           END-IF

           CLOSE F-OUT
           IF WS-FS-OUT NOT = "00"
           DISPLAY "ERREUR CLOSE F-OUT  FS=" WS-FS-OUT
           END-IF
           .
