       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOGGERG5.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT F-LOG
               ASSIGN       TO LOGGERPS
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE  IS SEQUENTIAL
               FILE STATUS  IS WS-FS-LOG.
       DATA DIVISION.
       FILE SECTION.
       FD  F-LOG
           RECORDING MODE IS F
           RECORD CONTAINS 200 CHARACTERS.
       01  ENR-LOG                    PIC X(200).
       WORKING-STORAGE SECTION.
       77 WS-FS-LOG                  PIC XX  VALUE SPACES.
       77 WS-LOG-OPEN                PIC X   VALUE 'N'.
       01 WS-TIMESTAMP               PIC X(19).
       01 WS-DATE-FMT       PIC X(19).
       LINKAGE SECTION.
       01  LK-LOG-COMMAND             PIC X.
       01  LK-LOG-FIELD-NAME          PIC X(30).
       01  LK-LOG-CONTEXT             PIC X(80).

       PROCEDURE DIVISION USING
            LK-LOG-COMMAND
            LK-LOG-FIELD-NAME
            LK-LOG-CONTEXT
            .
       MAIN-LOG.
           EVALUATE LK-LOG-COMMAND
              WHEN 'O'
                 PERFORM OUVRIR-LOG
              WHEN 'L'
                 PERFORM ECRIRE-LOG
              WHEN 'F'
                 PERFORM FERMER-LOG
              WHEN OTHER
                 CONTINUE
           END-EVALUATE
           GOBACK
           .
       OUVRIR-LOG.
           IF WS-LOG-OPEN NOT = 'Y'
              OPEN OUTPUT F-LOG
              IF WS-FS-LOG NOT = '00'
                 DISPLAY 'ERREUR OUVERTURE LOG F-LOG, FS=' WS-FS-LOG
              END-IF
              MOVE 'Y' TO WS-LOG-OPEN
           END-IF
           .
       ECRIRE-LOG.
           MOVE FUNCTION CURRENT-DATE(1:14) TO WS-TIMESTAMP
           STRING
             WS-TIMESTAMP(1:4)  DELIMITED BY SIZE
             '-'
             WS-TIMESTAMP(5:2)  DELIMITED BY SIZE
             '-'
             WS-TIMESTAMP(7:2)  DELIMITED BY SIZE
             ' '
             WS-TIMESTAMP(9:2)  DELIMITED BY SIZE
             ':'
             WS-TIMESTAMP(11:2) DELIMITED BY SIZE
             ':'
             WS-TIMESTAMP(13:2) DELIMITED BY SIZE
             INTO WS-DATE-FMT
           END-STRING
           IF WS-LOG-OPEN NOT = 'Y'
              OPEN EXTEND F-LOG
              IF WS-FS-LOG NOT = '00'
                 DISPLAY 'ERREUR OUVERTURE (EXTEND) LOG F-LOG, FS='
                         WS-FS-LOG
              END-IF
              MOVE 'Y' TO WS-LOG-OPEN
           END-IF
           MOVE ALL ' ' TO ENR-LOG
           STRING
              WS-DATE-FMT      DELIMITED BY SIZE
              ';'
              LK-LOG-FIELD-NAME DELIMITED BY SIZE
              ';'
              LK-LOG-CONTEXT    DELIMITED BY SIZE
              INTO ENR-LOG
           END-STRING
           WRITE ENR-LOG
           IF WS-FS-LOG NOT = '00'
              DISPLAY 'ERREUR ECRITURE LOG F-LOG, FS=' WS-FS-LOG
           END-IF
           .
       FERMER-LOG.
           IF WS-LOG-OPEN = 'Y'
              CLOSE F-LOG
              IF WS-FS-LOG NOT = '00'
                 DISPLAY 'ERREUR FERMETURE LOG F-LOG, FS=' WS-FS-LOG
              END-IF
              MOVE 'N' TO WS-LOG-OPEN
           END-IF
           .
